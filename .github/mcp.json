{
  "mcpServers": {
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp",
      "headers": {
        "Authorization": "Bearer ${NEON_API_KEY}"
      },
      "tools": [
        "list_projects",
        "describe_project",
        "list_branches",
        "get_default_branch",
        "create_branch",
        "delete_branch",
        "get_connection_string",
        "get_database_tables",
        "describe_table_schema",
        "compare_database_schema",
        "run_sql",
        "run_sql_transaction",
        "prepare_database_migration",
        "complete_database_migration",
        "create_snapshot",
        "list_snapshots",
        "restore_snapshot",
        "finalize_branch_restore"
      ]
    }
  }
}
